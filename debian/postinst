#!/bin/sh
set -e

CONFIG=/etc/svxlink/svxlink.conf
TEMPLATE=/usr/share/sx1255-fm-repeater/svxlink.conf.in
CONFIG_MARK=/etc/svxlink/.sx1255-fm-repeater-configured

needs_config() {
    [ ! -f "$CONFIG_MARK" ] && return 0
    [ ! -f "$CONFIG" ] && return 0
    grep -Eq 'N0CALL|CHANGE_ME|example\.org|@REPEATER_CALLSIGN@|@REFLECTOR_CALLSIGN@|@REFLECTOR_HOSTS@|@SVXLINK_AUTH_KEY@' "$CONFIG"
}

dialog_available() {
    command -v dialog >/dev/null 2>&1 && [ -r /dev/tty ] && [ -w /dev/tty ]
}

ask_input() {
    title=$1
    prompt=$2
    value=$3
    tmp=$(mktemp)
    if dialog --title "$title" --inputbox "$prompt" 9 72 "$value" 2>"$tmp" >/dev/tty </dev/tty; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

ask_password() {
    title=$1
    prompt=$2
    value=$3
    tmp=$(mktemp)
    if dialog --title "$title" --insecure --passwordbox "$prompt" 9 72 "$value" 2>"$tmp" >/dev/tty </dev/tty; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

write_svxlink_config() {
    repeater_callsign=$1
    reflector_callsign=$2
    reflector_hosts=$3
    auth_key=$4

    esc() {
        printf '%s' "$1" | sed 's/[\/&]/\\&/g'
    }

    tmp=$(mktemp)
    sed \
        -e "s/@REPEATER_CALLSIGN@/$(esc "$repeater_callsign")/g" \
        -e "s/@REFLECTOR_CALLSIGN@/$(esc "$reflector_callsign")/g" \
        -e "s/@REFLECTOR_HOSTS@/$(esc "$reflector_hosts")/g" \
        -e "s/@SVXLINK_AUTH_KEY@/$(esc "$auth_key")/g" \
        "$TEMPLATE" > "$tmp"
    install -m 0644 "$tmp" "$CONFIG"
    rm -f "$tmp"
    touch "$CONFIG_MARK"
}

configure_svxlink_dialog() {
    repeater_callsign=N0CALL-R
    reflector_callsign=N0CALL-L
    reflector_hosts=example.org:5300
    auth_key=CHANGE_ME

    while :; do
        tmp=$(mktemp)
        if ! dialog --clear --title "SX1255 FM repeater" \
            --menu "SvxLink configuration has not been completed." 17 78 6 \
            1 "Repeater callsign:  $repeater_callsign" \
            2 "Reflector callsign: $reflector_callsign" \
            3 "Reflector HOSTS:    $reflector_hosts" \
            4 "Reflector AUTH_KEY: $( [ "$auth_key" = CHANGE_ME ] && printf CHANGE_ME || printf '********' )" \
            5 "Write configuration" \
            6 "Skip for now" \
            2>"$tmp" >/dev/tty </dev/tty; then
            rm -f "$tmp"
            return 1
        fi
        choice=$(cat "$tmp")
        rm -f "$tmp"
        case "$choice" in
            1) repeater_callsign=$(ask_input "Repeater callsign" "Enter repeater callsign, e.g. YOURCALL-R:" "$repeater_callsign") || return 1 ;;
            2) reflector_callsign=$(ask_input "Reflector callsign" "Enter linked reflector callsign, e.g. YOURCALL-L:" "$reflector_callsign") || return 1 ;;
            3) reflector_hosts=$(ask_input "Reflector HOSTS" "Enter ReflectorLogic HOSTS, e.g. reflector.example.org:5300:" "$reflector_hosts") || return 1 ;;
            4) auth_key=$(ask_password "Reflector AUTH_KEY" "Enter SvxLink reflector password/AUTH_KEY:" "$auth_key") || return 1 ;;
            5) write_svxlink_config "$repeater_callsign" "$reflector_callsign" "$reflector_hosts" "$auth_key"; clear >/dev/tty; return 0 ;;
            6) clear >/dev/tty; return 1 ;;
        esac
    done
}

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi

if getent passwd svxlink >/dev/null 2>&1; then
    chown -R svxlink:svxlink /var/lib/sx1255-fm-repeater 2>/dev/null || true
fi

if command -v modprobe >/dev/null 2>&1; then
    modprobe snd-aloop 2>/dev/null || true
fi

if needs_config; then
    if dialog_available; then
        configure_svxlink_dialog || true
    else
        cat <<EOF
SvxLink configuration has not been completed.
Run this after installation or edit /etc/svxlink/svxlink.conf manually:
  dpkg-reconfigure sx1255-fm-repeater
EOF
    fi
fi

cat <<EOF
sx1255-fm-repeater installed.

Review /etc/default/sx1255-repeater and /etc/svxlink/svxlink.conf, then run:
  systemctl enable --now sx1255-repeater.service
  systemctl enable --now svx-ptt-bridge.service
  systemctl restart svxlink.service
EOF

exit 0
