#!/bin/sh
set -eu

package_name=sx1255-fm-repeater
version=0.1.3
prefix=/usr
spibindir=/usr/local/bin
sysconfdir=/etc
localstatedir=/var
systemdunitdir=/lib/systemd/system
defaultdir=/etc/default
svxlinkconfdir=/etc/svxlink
modprobedir=/etc/modprobe.d
modulesloaddir=/etc/modules-load.d
run_user=svxlink
run_group=svxlink
python=/usr/bin/python3
cc=${CC:-gcc}
cflags=${CFLAGS:--std=c11 -O2 -pthread -Wall -Wextra}
ldflags=${LDFLAGS:-}
ldlibs=${LDLIBS:--lasound -lm}
deb_arch=${DEB_ARCH:-}
repeater_callsign=${REPEATER_CALLSIGN:-N0CALL-R}
reflector_callsign=${REFLECTOR_CALLSIGN:-N0CALL-L}
reflector_hosts=${REFLECTOR_HOSTS:-example.org:5300}
svxlink_auth_key=${SVXLINK_AUTH_KEY:-CHANGE_ME}
use_dialog=auto

show_help() {
    cat <<EOF
Usage: ./configure [OPTIONS]

Options:
  --prefix=DIR              Install prefix, default /usr
  --bindir=DIR              Program directory, default PREFIX/bin
  --spibindir=DIR           SX1255 SPI helper directory, default /usr/local/bin
  --sysconfdir=DIR          Configuration root, default /etc
  --localstatedir=DIR       State root, default /var
  --systemdunitdir=DIR      systemd unit directory, default /lib/systemd/system
  --defaultdir=DIR          EnvironmentFile directory, default /etc/default
  --svxlinkconfdir=DIR      SvxLink config directory, default /etc/svxlink
  --modprobedir=DIR         modprobe.d directory, default /etc/modprobe.d
  --modulesloaddir=DIR      modules-load.d directory, default /etc/modules-load.d
  --run-user=USER           systemd service user, default svxlink
  --run-group=GROUP         systemd service group, default svxlink
  --python=PATH             Python interpreter, default /usr/bin/python3
  --package-name=NAME       Debian package name, default sx1255-fm-repeater
  --version=VERSION         Package version, default 0.1.3
  --deb-arch=ARCH           Debian arch, default from dpkg or uname
  --repeater-callsign=CALL  SvxLink repeater logic callsign, default N0CALL-R
  --reflector-callsign=CALL SvxLink reflector logic callsign, default N0CALL-L
  --reflector-hosts=HOSTS   SvxLink ReflectorLogic HOSTS value, default example.org:5300
  --auth-key=KEY            SvxLink reflector AUTH_KEY, default CHANGE_ME
  --no-dialog               Do not ask configuration questions with dialog
  CC=... CFLAGS=... LDFLAGS=... LDLIBS=... may also be set in environment.
EOF
}

dialog_inputbox() {
    title=$1
    prompt=$2
    value=$3
    tmp=${TMPDIR:-/tmp}/sx1255-fm-repeater-dialog.$$
    if dialog --title "$title" --inputbox "$prompt" 9 70 "$value" 2>"$tmp"; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

dialog_passwordbox() {
    title=$1
    prompt=$2
    value=$3
    tmp=${TMPDIR:-/tmp}/sx1255-fm-repeater-dialog.$$
    if dialog --title "$title" --insecure --passwordbox "$prompt" 9 70 "$value" 2>"$tmp"; then
        cat "$tmp"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

run_dialog_config() {
    if ! command -v dialog >/dev/null 2>&1; then
        echo "configure: dialog is not installed; install package 'dialog' or use --no-dialog with --repeater-callsign/--reflector-callsign/--reflector-hosts/--auth-key." >&2
        return 1
    fi

    while :; do
        choice=$(dialog --clear --title "SX1255 FM repeater configure" \
            --menu "Configure SvxLink identity, reflector endpoint and authentication." 16 78 6 \
            1 "Repeater callsign:  $repeater_callsign" \
            2 "Reflector callsign: $reflector_callsign" \
            3 "Reflector HOSTS:    $reflector_hosts" \
            4 "Reflector AUTH_KEY: $( [ "$svxlink_auth_key" = CHANGE_ME ] && printf CHANGE_ME || printf '********' )" \
            5 "Continue" \
            6 "Cancel" \
            3>&1 1>&2 2>&3) || return 1
        case "$choice" in
            1) repeater_callsign=$(dialog_inputbox "Repeater callsign" "Enter repeater callsign, e.g. YOURCALL-R:" "$repeater_callsign") || return 1 ;;
            2) reflector_callsign=$(dialog_inputbox "Reflector callsign" "Enter linked reflector callsign, e.g. YOURCALL-L:" "$reflector_callsign") || return 1 ;;
            3) reflector_hosts=$(dialog_inputbox "Reflector HOSTS" "Enter SvxLink ReflectorLogic HOSTS value, e.g. reflector.example.org:5300:" "$reflector_hosts") || return 1 ;;
            4) svxlink_auth_key=$(dialog_passwordbox "Reflector AUTH_KEY" "Enter SvxLink reflector password/AUTH_KEY:" "$svxlink_auth_key") || return 1 ;;
            5) break ;;
            6) return 1 ;;
        esac
    done
    clear
}

bindir_set=0
for arg in "$@"; do
    case "$arg" in
        --help|-h) show_help; exit 0 ;;
        --prefix=*) prefix=${arg#*=} ;;
        --bindir=*) bindir=${arg#*=}; bindir_set=1 ;;
        --spibindir=*) spibindir=${arg#*=} ;;
        --sysconfdir=*) sysconfdir=${arg#*=} ;;
        --localstatedir=*) localstatedir=${arg#*=} ;;
        --systemdunitdir=*) systemdunitdir=${arg#*=} ;;
        --defaultdir=*) defaultdir=${arg#*=} ;;
        --svxlinkconfdir=*) svxlinkconfdir=${arg#*=} ;;
        --modprobedir=*) modprobedir=${arg#*=} ;;
        --modulesloaddir=*) modulesloaddir=${arg#*=} ;;
        --run-user=*) run_user=${arg#*=} ;;
        --run-group=*) run_group=${arg#*=} ;;
        --python=*) python=${arg#*=} ;;
        --package-name=*) package_name=${arg#*=} ;;
        --version=*) version=${arg#*=} ;;
        --deb-arch=*) deb_arch=${arg#*=} ;;
        --repeater-callsign=*) repeater_callsign=${arg#*=} ;;
        --reflector-callsign=*) reflector_callsign=${arg#*=} ;;
        --reflector-hosts=*) reflector_hosts=${arg#*=} ;;
        --auth-key=*) svxlink_auth_key=${arg#*=} ;;
        --no-dialog) use_dialog=no ;;
        *) echo "configure: unknown option: $arg" >&2; exit 2 ;;
    esac
done

if [ "$use_dialog" != "no" ] && [ -t 0 ] && [ -t 1 ]; then
    run_dialog_config
elif [ "$use_dialog" != "no" ] && ! command -v dialog >/dev/null 2>&1; then
    echo "configure: warning: package 'dialog' is not installed; non-interactive defaults/options will be used." >&2
fi

if command -v dpkg-query >/dev/null 2>&1; then
    if ! dpkg-query -W -f='${Status}' svxlink-server 2>/dev/null | grep -q 'install ok installed'; then
        echo "configure: warning: runtime package 'svxlink-server' is not installed on this system." >&2
    fi
else
    echo "configure: warning: cannot check for runtime package 'svxlink-server' without dpkg-query." >&2
fi

if [ "${bindir_set}" -eq 0 ]; then
    bindir=$prefix/bin
fi
docdir=$prefix/share/doc/$package_name
datadir=$prefix/share/$package_name

if [ -z "$deb_arch" ]; then
    if command -v dpkg >/dev/null 2>&1; then
        deb_arch=$(dpkg --print-architecture)
    else
        deb_arch=$(uname -m)
    fi
fi

esc() {
    printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

render() {
    in=$1
    out=$2
    sed \
        -e "s/@PACKAGE_NAME@/$(esc "$package_name")/g" \
        -e "s/@VERSION@/$(esc "$version")/g" \
        -e "s/@PREFIX@/$(esc "$prefix")/g" \
        -e "s/@BINDIR@/$(esc "$bindir")/g" \
        -e "s/@SPIBINDIR@/$(esc "$spibindir")/g" \
        -e "s/@SYSCONFDIR@/$(esc "$sysconfdir")/g" \
        -e "s/@LOCALSTATEDIR@/$(esc "$localstatedir")/g" \
        -e "s/@SYSTEMDUNITDIR@/$(esc "$systemdunitdir")/g" \
        -e "s/@DEFAULTDIR@/$(esc "$defaultdir")/g" \
        -e "s/@SVXLINKCONFDIR@/$(esc "$svxlinkconfdir")/g" \
        -e "s/@MODPROBEDIR@/$(esc "$modprobedir")/g" \
        -e "s/@MODULESLOADDIR@/$(esc "$modulesloaddir")/g" \
        -e "s/@DOCDIR@/$(esc "$docdir")/g" \
        -e "s/@DATADIR@/$(esc "$datadir")/g" \
        -e "s/@RUN_USER@/$(esc "$run_user")/g" \
        -e "s/@RUN_GROUP@/$(esc "$run_group")/g" \
        -e "s/@PYTHON@/$(esc "$python")/g" \
        -e "s/@CC@/$(esc "$cc")/g" \
        -e "s/@CFLAGS@/$(esc "$cflags")/g" \
        -e "s/@LDFLAGS@/$(esc "$ldflags")/g" \
        -e "s/@LDLIBS@/$(esc "$ldlibs")/g" \
        -e "s/@DEB_ARCH@/$(esc "$deb_arch")/g" \
        -e "s/@REPEATER_CALLSIGN@/$(esc "$repeater_callsign")/g" \
        -e "s/@REFLECTOR_CALLSIGN@/$(esc "$reflector_callsign")/g" \
        -e "s/@REFLECTOR_HOSTS@/$(esc "$reflector_hosts")/g" \
        -e "s/@SVXLINK_AUTH_KEY@/$(esc "$svxlink_auth_key")/g" \
        "$in" > "$out"
}

render config.mk.in config.mk
render Makefile.in Makefile
mkdir -p build/systemd
mkdir -p build/debian
mkdir -p build/config
render systemd/sx1255-repeater.service.in build/systemd/sx1255-repeater.service
render systemd/svx-ptt-bridge.service.in build/systemd/svx-ptt-bridge.service
render debian/control.in build/debian/control
render config/svxlink.conf.in build/config/svxlink.conf

cat <<EOF
Configured $package_name $version
  prefix:          $prefix
  bindir:          $bindir
  spibindir:       $spibindir
  sysconfdir:      $sysconfdir
  systemdunitdir:  $systemdunitdir
  run user/group:  $run_user:$run_group
  deb arch:        $deb_arch
  repeater call:   $repeater_callsign
  reflector call:  $reflector_callsign
  reflector hosts: $reflector_hosts
  auth key:        $( [ "$svxlink_auth_key" = CHANGE_ME ] && printf CHANGE_ME || printf 'configured' )

Run: make
     sudo make install
     make deb
EOF
