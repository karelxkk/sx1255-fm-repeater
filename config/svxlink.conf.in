[GLOBAL]
LOGICS=RepeaterLogic,ReflectorLogic
LINKS=LinkToReflector
TIMESTAMP_FORMAT="%d.%m.%Y %H:%M:%S"
CARD_SAMPLE_RATE=16000
CARD_CHANNELS=1

[RepeaterLogic]
TYPE=Repeater
RX=Rx1
TX=Tx1
CALLSIGN=@REPEATER_CALLSIGN@
EVENT_HANDLER=/usr/share/svxlink/events.tcl
DEFAULT_LANG=cs_CZ
NO_REPEAT=0
OPEN_ON_CTCSS=100
OPEN_SQL_FLANK=OPEN
IDLE_TIMEOUT=10
RGR_SOUND_DELAY=0
SHORT_IDENT_INTERVAL=0
LONG_IDENT_INTERVAL=0

[ReflectorLogic]
TYPE=Reflector
HOSTS=@REFLECTOR_HOSTS@
CALLSIGN=@REPEATER_CALLSIGN@
AUTH_KEY=@SVXLINK_AUTH_KEY@
EVENT_HANDLER=/usr/share/svxlink/events.tcl
DEFAULT_LANG=cs_CZ
JITTER_BUFFER_DELAY=100
DEFAULT_TG=123
MONITOR_TGS=123
TG_SELECT_TIMEOUT=86400
MUTE_FIRST_TX_LOC=0
MUTE_FIRST_TX_REM=0
VERBOSE=1

[LinkToReflector]
CONNECT_LOGICS=RepeaterLogic::@REPEATER_CALLSIGN@,ReflectorLogic::@REFLECTOR_CALLSIGN@
DEFAULT_ACTIVE=1

[Rx1]
TYPE=Local
RX_ID=R
AUDIO_DEV=alsa:plughw:Loopback,1,1
AUDIO_CHANNEL=0
AUDIO_DEV_KEEP_OPEN=1
SQL_DET=CTCSS
CTCSS_FQ=88.5
CTCSS_MODE=4
CTCSS_OPEN_THRESH=15
CTCSS_CLOSE_THRESH=9
SQL_HANGTIME=200
SQL_START_DELAY=200
SQL_TIMEOUT=180
DEEMPHASIS=0
PREAMP=0
DTMF_DEC_TYPE=INTERNAL
DTMF_MUTING=1

[Tx1]
TYPE=Local
TX_ID=T
AUDIO_DEV=alsa:plughw:Loopback,0,0
AUDIO_CHANNEL=0
AUDIO_DEV_KEEP_OPEN=1
PTT_TYPE=PTY
PTT_PTY=/run/svxlink/ptt
PTT_HANGTIME=0
TX_DELAY=50
TIMEOUT=3600
PREEMPHASIS=0
MASTER_GAIN=0
LIMITER_THRESH=-6
