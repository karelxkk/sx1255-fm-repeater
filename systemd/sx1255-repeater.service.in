[Unit]
Description=SX1255 RX/TX repeater
Documentation=file:@DOCDIR@/README.md
After=local-fs.target sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@LOCALSTATEDIR@/lib/svxlink

EnvironmentFile=-@DEFAULTDIR@/sx1255-repeater

ExecStartPre=@SPIBINDIR@/sx1255-spi 430950020 438575000
#ExecStartPre=@SPIBINDIR@/sx1255-spi 430975020 438575000
ExecStartPre=@SPIBINDIR@/sx1255-spi-fixed -l 30 -a 75 -b 75 -R 0 -T 0
ExecStart=@BINDIR@/sx1255_repeater

Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sx1255-repeater

[Install]
WantedBy=multi-user.target
