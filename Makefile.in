include config.mk

BUILD_DIR := build
PKGROOT := $(BUILD_DIR)/debroot
DEB_DIR := $(BUILD_DIR)/deb
DEB_FILE := $(DEB_DIR)/$(PACKAGE_NAME)_$(VERSION)_$(DEB_ARCH).deb

.PHONY: all clean install uninstall deb distclean services configs

all: $(BUILD_DIR)/sx1255_repeater $(BUILD_DIR)/sx1255-spi $(BUILD_DIR)/sx1255-spi-fixed services configs

$(BUILD_DIR)/sx1255_repeater: src/sx1255_repeater.c config.mk
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ src/sx1255_repeater.c $(LDLIBS)

$(BUILD_DIR)/sx1255-spi: src/sx1255-spi.c config.mk
	@mkdir -p $(BUILD_DIR)
	$(CC) -D_DEFAULT_SOURCE $(CFLAGS) $(LDFLAGS) -o $@ src/sx1255-spi.c -lm

$(BUILD_DIR)/sx1255-spi-fixed: src/sx1255-spi-fixed.c config.mk
	@mkdir -p $(BUILD_DIR)
	$(CC) -D_DEFAULT_SOURCE $(CFLAGS) $(LDFLAGS) -o $@ src/sx1255-spi-fixed.c -ldl -lm

services: $(BUILD_DIR)/systemd/sx1255-repeater.service $(BUILD_DIR)/systemd/svx-ptt-bridge.service

configs: $(BUILD_DIR)/config/svxlink.conf

$(BUILD_DIR)/systemd/sx1255-repeater.service $(BUILD_DIR)/systemd/svx-ptt-bridge.service $(BUILD_DIR)/config/svxlink.conf: configure systemd/*.in config/svxlink.conf.in config.mk
	./configure --prefix="$(PREFIX)" --bindir="$(BINDIR)" --sysconfdir="$(SYSCONFDIR)" \
		--localstatedir="$(LOCALSTATEDIR)" --systemdunitdir="$(SYSTEMDUNITDIR)" \
		--defaultdir="$(DEFAULTDIR)" --svxlinkconfdir="$(SVXLINKCONFDIR)" \
		--modprobedir="$(MODPROBEDIR)" --modulesloaddir="$(MODULESLOADDIR)" \
		--run-user="$(RUN_USER)" --run-group="$(RUN_GROUP)" --python="$(PYTHON)" \
		--package-name="$(PACKAGE_NAME)" --version="$(VERSION)" --deb-arch="$(DEB_ARCH)" \
		--repeater-callsign="$(REPEATER_CALLSIGN)" --reflector-callsign="$(REFLECTOR_CALLSIGN)" \
		--reflector-hosts="$(REFLECTOR_HOSTS)" \
		--no-dialog

install: all
	install -d "$(DESTDIR)$(BINDIR)"
	install -m 0755 "$(BUILD_DIR)/sx1255_repeater" "$(DESTDIR)$(BINDIR)/sx1255_repeater"
	install -m 0755 scripts/svx_sx1255_ptt_bridge.py "$(DESTDIR)$(BINDIR)/svx_sx1255_ptt_bridge.py"
	install -d "$(DESTDIR)$(SPIBINDIR)"
	install -m 0755 "$(BUILD_DIR)/sx1255-spi" "$(DESTDIR)$(SPIBINDIR)/sx1255-spi"
	install -m 0755 "$(BUILD_DIR)/sx1255-spi-fixed" "$(DESTDIR)$(SPIBINDIR)/sx1255-spi-fixed"
	install -d "$(DESTDIR)$(SYSTEMDUNITDIR)"
	install -m 0644 "$(BUILD_DIR)/systemd/sx1255-repeater.service" "$(DESTDIR)$(SYSTEMDUNITDIR)/sx1255-repeater.service"
	install -m 0644 "$(BUILD_DIR)/systemd/svx-ptt-bridge.service" "$(DESTDIR)$(SYSTEMDUNITDIR)/svx-ptt-bridge.service"
	install -d "$(DESTDIR)$(SYSTEMDUNITDIR)/svxlink.service.d"
	install -m 0644 systemd/svxlink.service.d-sx1255-fm-repeater.conf "$(DESTDIR)$(SYSTEMDUNITDIR)/svxlink.service.d/sx1255-fm-repeater.conf"
	install -d "$(DESTDIR)$(DEFAULTDIR)"
	install -m 0644 config/sx1255-repeater.default "$(DESTDIR)$(DEFAULTDIR)/sx1255-repeater"
	install -d "$(DESTDIR)$(DATADIR)"
	install -m 0644 config/svxlink.conf.in "$(DESTDIR)$(DATADIR)/svxlink.conf.in"
	install -d "$(DESTDIR)$(MODPROBEDIR)"
	install -m 0644 config/snd-aloop.modprobe.conf "$(DESTDIR)$(MODPROBEDIR)/snd-aloop.conf"
	install -d "$(DESTDIR)$(MODULESLOADDIR)"
	install -m 0644 config/snd-aloop.modules-load.conf "$(DESTDIR)$(MODULESLOADDIR)/snd-aloop.conf"
	install -d "$(DESTDIR)$(LOCALSTATEDIR)/lib/svxlink"
	install -d "$(DESTDIR)$(DOCDIR)"
	install -m 0644 doc/README.md "$(DESTDIR)$(DOCDIR)/README.md"

uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/sx1255_repeater"
	rm -f "$(DESTDIR)$(BINDIR)/svx_sx1255_ptt_bridge.py"
	rm -f "$(DESTDIR)$(SPIBINDIR)/sx1255-spi"
	rm -f "$(DESTDIR)$(SPIBINDIR)/sx1255-spi-fixed"
	rm -f "$(DESTDIR)$(SYSTEMDUNITDIR)/sx1255-repeater.service"
	rm -f "$(DESTDIR)$(SYSTEMDUNITDIR)/svx-ptt-bridge.service"
	rm -f "$(DESTDIR)$(SYSTEMDUNITDIR)/svxlink.service.d/sx1255-fm-repeater.conf"
	rm -f "$(DESTDIR)$(DEFAULTDIR)/sx1255-repeater"
	rm -f "$(DESTDIR)$(MODPROBEDIR)/snd-aloop.conf"
	rm -f "$(DESTDIR)$(MODULESLOADDIR)/snd-aloop.conf"

deb: all
	rm -rf "$(PKGROOT)" "$(DEB_DIR)"
	$(MAKE) install DESTDIR="$(CURDIR)/$(PKGROOT)"
	install -d "$(PKGROOT)/DEBIAN"
	install -m 0644 "$(BUILD_DIR)/debian/control" "$(PKGROOT)/DEBIAN/control"
	install -m 0755 debian/postinst "$(PKGROOT)/DEBIAN/postinst"
	install -m 0755 debian/prerm "$(PKGROOT)/DEBIAN/prerm"
	install -m 0755 debian/postrm "$(PKGROOT)/DEBIAN/postrm"
	install -m 0644 debian/conffiles "$(PKGROOT)/DEBIAN/conffiles"
	install -d "$(DEB_DIR)"
	dpkg-deb --root-owner-group --build "$(PKGROOT)" "$(DEB_FILE)"
	@echo "Created $(DEB_FILE)"

clean:
	rm -f "$(BUILD_DIR)/sx1255_repeater" "$(BUILD_DIR)/sx1255-spi" "$(BUILD_DIR)/sx1255-spi-fixed"

distclean:
	rm -rf "$(BUILD_DIR)" Makefile config.mk
